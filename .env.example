# Required
OPENAI_API_KEY=your-openai-api-key-here

# ASR — options: tiny, base, small, medium, large
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Audio processing
APPLY_NOISE_REDUCTION=false

# Debug — set to true to save captured audio segments as WAV files
DEBUG_SAVE_SEGMENTS=false
DEBUG_SEGMENT_DIR=./debug_segments
